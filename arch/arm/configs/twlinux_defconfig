# Linux .config skeleton for the DSi (ARMv5TE, no MMU).
#
# Hand-written starting point. `make kernel` copies this to build/linux/.config
# and runs olddefconfig. CONFIG_ARCH_DSI must stay set here: it gates the
# arch/arm/Kconfig change (applied by sync-kernel) that keeps ARM_SINGLE_ARMV7M
# from forcing this no-MMU build into Cortex-M / THUMB2_KERNEL.
#
# Many of the !MMU ARMv5 options below depend on the mach-dsi port and the
# Kconfig loosening that sync-kernel applies — see STATUS.md.

CONFIG_LOCALVERSION="-twlinux"

# --- ARM / CPU / no-MMU -----------------------------------------------------
CONFIG_ARM=y
# !MMU. Mainline ARMv5 nommu is fragile — see STATUS.md.
# CONFIG_MMU is not set
CONFIG_CPU_ARM946E=y
CONFIG_CPU_32v5=y
CONFIG_AEABI=y
CONFIG_ARM_THUMB=y

# Machine: out-of-tree mach-dsi (synced into the tree by `make sync-kernel`).
CONFIG_ARCH_DSI=y
CONFIG_MACH_NINTENDO_DSI=y

# Memory layout — main RAM at 0x02000000, 16 MB on DSi. The bootloader
# occupies 0x02000000..~0x02100000 while staging the kernel, so we link
# the kernel 1 MB up to avoid trampling fread()'s own running code mid-load.
# DRAM_BASE/SIZE are only honored when SET_MEM_PARAM=y; without it the
# Kconfig fallback resets them to 0x00800000 / 0x00800000 every time
# olddefconfig runs, which silently breaks our boot.
CONFIG_SET_MEM_PARAM=y
CONFIG_PHYS_OFFSET=0x02100000
CONFIG_PAGE_OFFSET=0x02100000
CONFIG_DRAM_BASE=0x02100000
CONFIG_DRAM_SIZE=0x00F00000
CONFIG_FLATMEM=y

# --- Kernel features --------------------------------------------------------
CONFIG_EMBEDDED=y
CONFIG_EXPERT=y
CONFIG_OPTIMIZE_FOR_SIZE=y
CONFIG_PRINTK=y
CONFIG_EARLY_PRINTK=y
CONFIG_DEBUG_KERNEL=y
CONFIG_DEBUG_LL=y
CONFIG_DEBUG_DSI_EARLYFB=y

# --- Early console over the no$gba/melonDS debug port ----------------------
# 0x04FFFA1C: write a byte → emulator logs the character. Boot with
# earlycon=ntr_nocash on the kernel command line (set in nintendo-dsi.dts).
CONFIG_TTY=y
CONFIG_SERIAL_CORE=y
CONFIG_SERIAL_CORE_CONSOLE=y
CONFIG_SERIAL_EARLYCON=y
CONFIG_SERIAL_EARLYCON_NTR_NOCASH=y

# Single-core scheduler — ARM7 is a co-processor, not a Linux CPU.
# CONFIG_SMP is not set
CONFIG_HZ_100=y
CONFIG_HZ=100
CONFIG_PREEMPT_NONE=y

# --- Init / userspace -------------------------------------------------------
CONFIG_BLK_DEV_INITRD=y
CONFIG_INITRAMFS_SOURCE=""
# Static-ELF init (init/init.c) built with arm-none-eabi-gcc -nostdlib.
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_FLAT=y
CONFIG_BINFMT_ZFLAT=y
CONFIG_BINFMT_SHARED_FLAT=y

# --- Filesystems ------------------------------------------------------------
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_TMPFS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
# Long-term: VFAT for SD card, ext4 for an SD-resident rootfs.
# CONFIG_VFAT_FS=y
# CONFIG_EXT4_FS=y

