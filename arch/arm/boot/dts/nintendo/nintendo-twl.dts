//
// nintendo-twl.dts — board file for the Nintendo DSi (DSi mode, 16 MB RAM).

/dts-v1/;
#include "nintendo-twl.dtsi"

/ {
	model = "Nintendo DSi";
	compatible = "nintendo,twl";

	// DSi mode: 16 MB main RAM at 0x02000000.
	// (NDS backwards-compatibility mode has only 4 MB here.)
	memory@2000000 {
		device_type = "memory";
		reg = <0x02000000 0x01000000>;
	};

	chosen {
		// lpj=1000000: temporary workaround for missing clocksource.
		// Remove once a nintendo,twl-intc IRQ driver and matching
		// clocksource driver are in place.
		bootargs = "console=ttyS0 earlyprintk debug earlycon=ntr_nocash keep_bootcon lpj=1000000 rdinit=/sbin/init";
		// stdout-path will point at the framebuffer console once that
		// driver lands.  Until then, output goes to the melonDS debug log.
		// Initramfs is embedded in the kernel Image via CONFIG_INITRAMFS_SOURCE.
	};
};
